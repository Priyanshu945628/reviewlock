# ==============================================================================
# ReviewLock Environment Configuration (.env.example)
# CONTRACT §8 — Every variable required for local development and Railway deploy
# ==============================================================================

# Database: PostgreSQL connection URL (e.g. Railway Postgres reference variable ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reviewlock"

# Application URL: Public base URL for the application (used in share links and CORS headers)
APP_URL="http://localhost:3000"

# Editor Session Secret: Minimum 32-character random string used to sign editor session cookies
SESSION_SECRET="replace-with-at-least-32-chars-random-session-secret-key"

# Stream Token Secret: HMAC key for short-lived (60s) viewer playback tokens
STREAM_TOKEN_SECRET="replace-with-at-least-32-chars-stream-hmac-secret-key"

# Download Token Secret: HMAC key for one-time (5 min) unlocked original download tokens
DOWNLOAD_TOKEN_SECRET="replace-with-at-least-32-chars-download-hmac-secret-key"

# Google OAuth Client ID: From Google Cloud Console OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Google OAuth Client Secret: From Google Cloud Console OAuth 2.0 Credentials
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-oauth-client-secret"

# Google OAuth Refresh Token: Generated once via `npm run drive:token`
GOOGLE_REFRESH_TOKEN="1//your-google-oauth-refresh-token"

# Google Drive Root Folder ID: ID of the dedicated private 'ReviewLock-Originals' folder
GOOGLE_DRIVE_ROOT_FOLDER_ID="your-google-drive-root-folder-id"

# Data Directory: Local storage mount point for uploads, chunks, and preview renditions (Railway Volume: /data)
DATA_DIR="./data"

# Maximum Upload Size (GB): Maximum allowed single file upload size in Gigabytes
MAX_UPLOAD_GB="5"

# Maximum Storage Per User (GB): Storage quota per editor before rejecting uploads
MAX_STORAGE_PER_USER_GB="20"

# Maximum Preview Height: Maximum vertical resolution in pixels for generated HLS preview renditions
PREVIEW_MAX_HEIGHT="720"

# Resend API Key: (Optional) Used in notification chunk for client viewing email notifications
RESEND_API_KEY=""

# Node Environment: 'development', 'test', or 'production'
NODE_ENV="development"

# Server Port: Port for Next.js web application (Railway dynamically injects PORT)
PORT="3000"
